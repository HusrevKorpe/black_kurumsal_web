# Uygulama (pooled bağlantı; Supabase'de 6543 transaction pooler)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Prisma CLI / migration (direkt bağlantı, 5432)
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Entegrasyon testleri için ayrı veritabanı
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/black_test"

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Yalnızca sunucu! Tarayıcıya asla sızmaz.
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="media"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sentry: boşsa hata izleme kapalı (yerel, test). Canlıda Vercel ortam değişkeninden gelir.
NEXT_PUBLIC_SENTRY_DSN=""
# Yalnızca build sırasında kaynak haritası yüklemek için (Vercel/CI'da tanımlanır, yerelde gerekmez)
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Vercel Cron yetkisi (Vercel bunu Authorization: Bearer başlığıyla gönderir). Boşsa cron uçları kapalı.
CRON_SECRET=""
