generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mekan (VENUE): fiziksel tek yer, kendi adresi ve saati var (Black Garden).
/// Bölge (DISTRICT): yalnızca gruplama etiketi (Çarşı, Iyaş).
enum LocationKind {
  VENUE
  DISTRICT
}

enum ShopType {
  PLAYSTATION
  INTERNET_CAFE
  FOOD
  APART
  OTHER
}

enum StaffRole {
  OWNER
  MANAGER
}

enum CampaignScope {
  GLOBAL
  LOCATION
  SHOP
}
