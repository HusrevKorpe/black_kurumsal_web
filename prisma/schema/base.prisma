generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Mekan (VENUE): fiziksel tek yer, kendi adresi ve saati var (Black Garden).
/// Bölge (DISTRICT): yalnızca gruplama etiketi (Çarşı, Iyaş).
enum LocationKind {
  VENUE
  DISTRICT
}

enum ShopType {
  PLAYSTATION
  INTERNET_CAFE
  FOOD
  APART
  OTHER
}

enum StaffRole {
  OWNER
  MANAGER
}

enum CampaignScope {
  GLOBAL
  LOCATION
  SHOP
}

enum AnalyticsEventType {
  PAGE_VIEW
  CALL_CLICK
  WHATSAPP_CLICK
  DIRECTIONS_CLICK
  INSTAGRAM_CLICK
  SHOP_CARD_CLICK
  LOCATION_CARD_CLICK
  CAMPAIGN_CLICK
  GALLERY_OPEN
}

/// Tarayıcı imzasından çıkarılır; ikiden fazla ayrım güvenilir değil.
enum DeviceKind {
  MOBILE
  DESKTOP
}
