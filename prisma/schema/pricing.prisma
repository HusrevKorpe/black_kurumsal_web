model PriceCategory {
  id          String   @id @default(uuid(7))
  shopId      String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items PriceItem[]

  @@index([shopId, sortOrder])
}

/// price boş olabilir: kategori bilgi listesi olarak da kullanılır (ör. "Oyunlar").
model PriceItem {
  id          String   @id @default(uuid(7))
  categoryId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  /// "saat", "gece", "porsiyon", "adet" ... serbest metin, en fazla 20 karakter
  unit        String?  @db.VarChar(20)
  imageId     String?
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image    Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([categoryId, sortOrder])
}
